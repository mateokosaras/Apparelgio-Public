# Local Apparelgio backend configuration. Copy this file to .env and replace
# the placeholder values; .env is intentionally ignored by Git.
PORT=3000
CORS_ORIGINS=
AI_REQUESTS_PER_MINUTE=30
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
EXTERNAL_REQUEST_TIMEOUT_MS=10000
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_MS=800

# Required for real garment-image analysis. Keep this only on the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Public Appwrite project values used to validate short-lived user JWTs.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6aa3ef4e000648946540
